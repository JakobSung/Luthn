{
  "ConnectionStrings": {
    "LuthnDb": "Host=localhost;Port=5432;Database=luthn;Username=luthn"
  },
  "Luthn": {
    "Classification": {
      "Provider": "mock",
      "AllowMock": true,
      "Runtime": {
        "TimeoutSeconds": 30,
        "MaxAttempts": 2,
        "RetryDelayMilliseconds": 200
      }
    },
    "Database": {
      "EnableRetries": true,
      "MaxRetryCount": 5,
      "MaxRetryDelaySeconds": 10
    },
    "Memory": {
      "AutomaticTurnRetentionDays": 30,
      "AutomaticTurnCleanupEnabled": true,
      "AutomaticTurnCleanupIntervalMinutes": 60,
      "AutomaticTurnCleanupBatchSize": 100
    },
    "Audit": {
      "Retention": {
        "CleanupEnabled": false,
        "CleanupIntervalMinutes": 60,
        "CleanupBatchSize": 100,
        "AccessDays": 365,
        "SecurityDays": 365,
        "ConfigurationDays": 730,
        "PublicationDays": 365,
        "IngestionDays": 90,
        "RetentionDays": 730
      }
    },
    "Host": {
      "EnableForwardedHeaders": false,
      "TrustAllForwardedHeaders": false,
      "EnforceHttps": false,
      "RequestTimeoutSeconds": 65,
      "RateLimitPermitLimit": 600,
      "RateLimitWindowSeconds": 60
    },
    "Hub": {
      "Ingress": {
        "Enabled": false,
        "MaxCapsuleBytes": 16384,
        "OrganizationPendingLimit": 5000,
        "WorkspacePendingLimit": 1000,
        "MemberPendingLimit": 500,
        "AgentPendingLimit": 250,
        "OrganizationPerMinuteLimit": 6000,
        "WorkspacePerMinuteLimit": 1200,
        "MemberPerMinuteLimit": 600,
        "AgentPerMinuteLimit": 300,
        "RetryAfterSeconds": 5,
        "WorkerEnabled": false,
        "WorkerBatchSize": 20,
        "WorkerPerWorkspaceBatchLimit": 5,
        "WorkerPollSeconds": 5,
        "WorkerLeaseSeconds": 120,
        "WorkerMaxAttempts": 5,
        "WorkerBaseRetrySeconds": 2
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
